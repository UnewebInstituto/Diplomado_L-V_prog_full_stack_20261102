Algoritmo ej02_condicionales
	//Declaracion de variables
	Definir edad Como Entero
	//Lectura estandar
	Escribir 'Por favor ingrese la edad:'
	Leer edad 
	// Condicional simple
	si edad < 18 Entonces
		Escribir 'Es menor de edad'
		si no 
			Escribir 'Es mayor de edad'
		FinSi
	FinSi
	
	
FinAlgoritmo

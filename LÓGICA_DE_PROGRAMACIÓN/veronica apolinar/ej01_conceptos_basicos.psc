Algoritmo ej01_conceptos_basicos
	// declaracion de varibles
	Escribir  'Declaracion de variables'
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir peso Como Real
	Definir estudiante Como Lógico
	// Inicializacion de variables
	Escribir 'Inicializacion de variable'
	nombre <- 'yolanda'
	edad <- 32
	peso <- 58.5
	estudiante <- Verdadero
	// Escritura estandar
	Escribir 'Escritura estandar'
	Escribir 'Contenido inicial de las variables:'
	Escribir nombre
	Escribir edad
	Escribir peso
	Escribir estudiante
	//Lectura estandar
	Escribir 'Lectura estandar'
	Escribir 'Por favor ingrese los siguientes datos:'
	Escribir 'Nombre:'
	Leer nombre
	Escribir 'Edad:'
	Leer edad
	Escribir 'Peso (colocar los decimales usando . ejemplo 123.45):'
	Leer peso
	
	
FinAlgoritmo

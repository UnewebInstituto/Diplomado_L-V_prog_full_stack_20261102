Algoritmo ej01_conceptos_basicos
	// Declaración de variables
	Escribir "Declaración de variables"
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir peso Como Real
	Definir estudiante Como Lógico
	// Inicialización de variables
	Escribir "Inicialización de variables"
	nombre <- 'YOLANDA'
	edad <- 32
	peso <- 58.5
	estudiante <- Verdadero
	// Escritura estándar
	Escribir "Escritura estándar"
	Escribir 'Contenido inicial de las variables:'
	Escribir nombre
	Escribir edad
	Escribir peso
	Escribir estudiante
	// Lectura estándar
	Escribir "Lectura estándar"
	Escribir "Por favor ingrese los siguientes datos"
	Escribir "Nombre:"
	Leer nombre
	Escribir "Edad:"
	Leer edad
	Escribir "Peso (colocar los decimales usando . por ejemplo 123.45):"
	Leer peso
FinAlgoritmo

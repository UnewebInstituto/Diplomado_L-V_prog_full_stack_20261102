Algoritmo ej01_conceptosbasicos
	// Declaracion de variables
	Escribir "declaracion de variables"
	Definir nombre Como Cadena
	Definir edad Como Entero
	Definir peso Como Real
	Definir estudiante Como Lógico
	// inicializacion de variables
	Escribir "inicializacion de variables"
	nombre <- ' Yolanda'
	edad <- 32
	peso <- 58.5
	estudiante <- Verdadero
	// escritura estandar
	Escribir "escritura estandar"
	Escribir 'Contenido inicial  de las variables'
	Escribir nombre
	Escribir edad
	Escribir peso
	Escribir estudiante
	//lectura estandar
	Escribir "lectura estandar"
	Escribir "Por favor ingrese los siguientes datos"
	Escribir "nombre"
	Leer nombre
	Escribir "edad"
	Leer edad
	Escribir "peso (colocar los decimales usando . por ejemplo 123.45):"
	leer peso
	escribir "Verdadero"
	
FinAlgoritmo
